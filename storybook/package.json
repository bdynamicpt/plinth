{
  "name": "@bdynamic/plinth-storybook",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static --quiet",
    "lint": "tsc --noEmit",
    "test": "vitest run && npm run test:stories",
    "test:stories": "concurrently --kill-others --success first --names serve,test \"http-server storybook-static --port 6007 --silent\" \"wait-on tcp:127.0.0.1:6007 && test-storybook --url http://127.0.0.1:6007\""
  },
  "dependencies": {
    "@bdynamic/plinth-blade": "*",
    "@bdynamic/plinth-css": "*",
    "@bdynamic/plinth-tokens": "*",
    "@bdynamic/plinth-vue": "*"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-themes": "^10.6.2",
    "@storybook/html": "^10.6.2",
    "@storybook/html-vite": "^10.6.2",
    "@storybook/test-runner": "^0.26.0",
    "@types/jsdom": "^30.0.0",
    "axe-playwright": "^2.2.2",
    "concurrently": "^10.0.6",
    "http-server": "^14.1.1",
    "jsdom": "^30.1.3",
    "storybook": "^10.6.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "wait-on": "^9.5.1"
  }
}
