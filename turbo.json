{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [
    "tsconfig.base.json",
    "eslint.config.js",
    "prettier.config.js",
    ".prettierignore",
    "stylelint.config.js"
  ],
  "globalPassThroughEnv": ["__MISE_*", "MISE_*", "LERD_*", "PLAYWRIGHT_*", "CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["build", "//#test:scripts"]
    },
    "build-storybook": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    },
    "storybook": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "//#lint": {},
    "//#test:scripts": {
      "inputs": ["scripts/**"]
    }
  }
}
