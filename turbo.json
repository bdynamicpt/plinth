{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [
    "tsconfig.base.json",
    "eslint.config.js",
    "prettier.config.js",
    ".prettierignore",
    "stylelint.config.js"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^build", "//#lint:root"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "build-storybook": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    },
    "storybook": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "//#lint:root": {
      "inputs": ["$TURBO_DEFAULT$", "!packages/blade/**/*.php"]
    }
  }
}
