{
  "name": "@bdynamic/plinth",
  "version": "0.0.0",
  "description": "The design system of BDynamic's projects: tokens, plain HTML and CSS components, and thin Blade and Vue layers.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/tokens",
    "packages/css",
    "packages/vue",
    "packages/blade",
    "storybook"
  ],
  "exports": {
    "./tokens": {
      "types": "./packages/tokens/dist/index.d.ts",
      "default": "./packages/tokens/dist/index.js"
    },
    "./tokens.css": "./packages/tokens/dist/tokens.css",
    "./tailwind.css": "./packages/tokens/dist/tailwind-theme.css",
    "./css": "./packages/css/dist/plinth.css",
    "./fonts.css": "./packages/css/dist/fonts/index.css",
    "./css/*": "./packages/css/dist/*",
    "./vue": {
      "types": "./packages/vue/dist/index.d.ts",
      "default": "./packages/vue/dist/index.js"
    }
  },
  "files": [
    "packages/tokens/dist",
    "packages/css/dist",
    "packages/vue/dist"
  ],
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "scripts": {
    "check": "turbo run lint test build build-storybook",
    "build": "turbo run build",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint . && prettier --check --cache .",
    "format": "prettier --write --cache . && stylelint --fix \"packages/css/src/**/*.css\" && composer --working-dir=packages/blade format",
    "test": "turbo run test",
    "storybook": "turbo run storybook",
    "build-storybook": "turbo run build-storybook"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.6.2",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.2",
    "turbo": "^2.11.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "jest-runtime": "30.4.2"
  }
}
