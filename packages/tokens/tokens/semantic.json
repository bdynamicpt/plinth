{
  "$description": "Semantic tokens that do not change with the theme. Components use these.",
  "space": {
    "$type": "dimension",
    "0": {
      "$value": "{ref.space.0}"
    },
    "0-5": {
      "$value": "{ref.space.0-5}"
    },
    "1": {
      "$value": "{ref.space.1}"
    },
    "2": {
      "$value": "{ref.space.2}"
    },
    "3": {
      "$value": "{ref.space.3}"
    },
    "4": {
      "$value": "{ref.space.4}"
    },
    "5": {
      "$value": "{ref.space.5}"
    },
    "6": {
      "$value": "{ref.space.6}"
    },
    "8": {
      "$value": "{ref.space.8}"
    },
    "10": {
      "$value": "{ref.space.10}"
    },
    "12": {
      "$value": "{ref.space.12}"
    },
    "14": {
      "$value": "{ref.space.14}"
    },
    "16": {
      "$value": "{ref.space.16}"
    }
  },
  "radius": {
    "$type": "dimension",
    "control": {
      "$value": "{ref.radius.6}",
      "$description": "Buttons, inputs and other controls."
    },
    "container": {
      "$value": "{ref.radius.10}",
      "$description": "Cards, sheets and dialogs."
    },
    "pill": {
      "$value": "{ref.radius.full}",
      "$description": "Badges and other pill shapes."
    }
  },
  "border-width": {
    "$type": "dimension",
    "thin": {
      "$value": "{ref.border-width.1}",
      "$description": "Control and card edges."
    },
    "thick": {
      "$value": "{ref.border-width.2}",
      "$description": "Strokes that must stay visible, such as a spinner."
    }
  },
  "opacity": {
    "$type": "number",
    "disabled": {
      "$value": 0.5,
      "$description": "Disabled controls. WCAG exempts disabled controls from contrast, but they still read as controls."
    }
  },
  "focus-ring": {
    "$type": "dimension",
    "$description": "The focus indicator every focusable element shows on :focus-visible, in color.focus-ring. It sits on the element's edge (offset); solid filled controls use offset-filled, so the ring does not merge with their fill.",
    "width": {
      "$value": "{ref.border-width.2}"
    },
    "offset": {
      "$value": "0"
    },
    "offset-filled": {
      "$value": "{ref.border-width.2}"
    },
    "offset-inset": {
      "$value": "-2px",
      "$description": "Inside the element's edge, minus the ring's width: for full-width rows in a scrolling container, which would cut off a ring drawn outside them."
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "body": {
        "$value": "{ref.font.family.sans}"
      },
      "mono": {
        "$value": "{ref.font.family.mono}"
      }
    },
    "size": {
      "$type": "dimension",
      "$description": "UI text is md (14px), with sm (13px) and xs (12px) below it; reading text is lg (15px); larger sizes are for headings.",
      "xs": {
        "$value": "{ref.font.size.12}"
      },
      "sm": {
        "$value": "{ref.font.size.13}"
      },
      "md": {
        "$value": "{ref.font.size.14}"
      },
      "lg": {
        "$value": "{ref.font.size.15}"
      },
      "xl": {
        "$value": "{ref.font.size.18}"
      },
      "2xl": {
        "$value": "{ref.font.size.24}"
      },
      "3xl": {
        "$value": "{ref.font.size.30}"
      },
      "4xl": {
        "$value": "{ref.font.size.36}"
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": "{ref.font.weight.400}"
      },
      "medium": {
        "$value": "{ref.font.weight.500}"
      },
      "semibold": {
        "$value": "{ref.font.weight.600}"
      },
      "bold": {
        "$value": "{ref.font.weight.700}"
      }
    },
    "leading": {
      "$type": "number",
      "tight": {
        "$value": "{ref.font.leading.125}"
      },
      "normal": {
        "$value": "{ref.font.leading.150}"
      }
    },
    "tracking": {
      "$type": "dimension",
      "$description": "Letter spacing: tight for headings, tighter for large display type.",
      "normal": {
        "$value": "{ref.font.tracking.0}"
      },
      "snug": {
        "$value": "{ref.font.tracking.neg-1}"
      },
      "tight": {
        "$value": "{ref.font.tracking.neg-2}"
      },
      "tighter": {
        "$value": "{ref.font.tracking.neg-4}"
      }
    }
  },
  "duration": {
    "$type": "duration",
    "$description": "Drops to 0ms under prefers-reduced-motion.",
    "fast": {
      "$value": "{ref.duration.120}"
    },
    "normal": {
      "$value": "{ref.duration.200}"
    },
    "slow": {
      "$value": "{ref.duration.320}"
    }
  },
  "easing": {
    "$type": "cubicBezier",
    "standard": {
      "$value": "{ref.easing.standard}"
    },
    "enter": {
      "$value": "{ref.easing.enter}"
    },
    "exit": {
      "$value": "{ref.easing.exit}"
    }
  },
  "control": {
    "$type": "dimension",
    "$description": "Control heights (28, 32 and 40 px). On a touch screen every control keeps a 40px hit area.",
    "sm": {
      "$value": "{ref.size.28}"
    },
    "md": {
      "$value": "{ref.size.32}"
    },
    "lg": {
      "$value": "{ref.size.40}"
    }
  },
  "touch-target": {
    "$type": "dimension",
    "$value": "{ref.size.40}",
    "$description": "The smallest touch target any component may have."
  },
  "size": {
    "$type": "dimension",
    "icon": {
      "$description": "Icon sizes (16, 20 and 24 px). md is the default.",
      "sm": {
        "$value": "{ref.size.16}"
      },
      "md": {
        "$value": "{ref.size.20}"
      },
      "lg": {
        "$value": "{ref.size.24}"
      }
    },
    "row": {
      "$value": "{ref.size.44}",
      "$description": "The minimum height of a row in a list or sheet (44 px)."
    },
    "avatar": {
      "$description": "Avatar sizes (24, 32, 40 and 56 px). md is the default.",
      "sm": {
        "$value": "{ref.size.24}"
      },
      "md": {
        "$value": "{ref.size.32}"
      },
      "lg": {
        "$value": "{ref.size.40}"
      },
      "xl": {
        "$value": "{ref.size.56}"
      }
    },
    "dialog": {
      "$value": "{ref.size.480}",
      "$description": "The width of a dialog or a centred sheet on a wider screen (480 px)."
    },
    "panel": {
      "$value": "{ref.size.400}",
      "$description": "The width of a side panel on a wider screen (400 px)."
    }
  },
  "layer": {
    "$type": "number",
    "$description": "Stacking order. Components use these, never a raw z-index.",
    "base": {
      "$value": 0
    },
    "sticky": {
      "$value": 100
    },
    "overlay": {
      "$value": 200
    },
    "sheet": {
      "$value": 300
    },
    "toast": {
      "$value": 400
    }
  },
  "breakpoint": {
    "$type": "dimension",
    "$description": "Mobile first: base rules are the phone; these add to them.",
    "md": {
      "$value": "768px"
    },
    "lg": {
      "$value": "1280px"
    }
  }
}
