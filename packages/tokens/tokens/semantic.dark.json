        "blur": "2px",
        "spread": "0"
      }
    },
    "2": {
      "$value": {
        "color": "{ref.color.black-alpha.50}",
        "offsetX": "0",
        "offsetY": "4px",
        "blur": "12px",
        "spread": "0"
      }
    },
    "3": {
      "$value": {
        "color": "{ref.color.black-alpha.60}",
        "offsetX": "0",
        "offsetY": "12px",
        "blur": "32px",
        "spread": "0"
      }
    }
