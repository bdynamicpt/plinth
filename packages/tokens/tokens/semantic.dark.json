{
  "$description": "Semantic tokens for the dark theme: the same names as the light theme.",
  "color": {
    "$type": "color",
    "surface": {
      "$value": "{ref.color.neutral.950}"
    },
    "surface-raised": {
      "$value": "{ref.color.neutral.900}"
    },
    "surface-sunken": {
      "$value": "{ref.color.neutral.1000}"
    },
    "surface-hover": {
      "$value": "{ref.color.neutral.850}",
      "$description": "A small surface step for hover, never a colour jump."
    },
    "text": {
      "$value": "{ref.color.neutral.100}"
    },
    "text-muted": {
      "$value": "{ref.color.neutral.300}"
    },
    "text-subtle": {
      "$value": "{ref.color.neutral.400}",
      "$description": "The third text level: placeholders, timestamps, disabled labels."
    },
    "border": {
      "$value": "{ref.color.chalk-alpha.10}",
      "$description": "Translucent, so it sits right on any surface."
    },
    "border-strong": {
      "$value": "{ref.color.chalk-alpha.20}"
    },
    "divider": {
      "$value": "{ref.color.chalk-alpha.6}"
    },
    "primary": {
      "$value": "{ref.color.neutral.100}",
      "$description": "The primary button: inverted neutral by default (ADR 3). A brand usually sets its own colour here, with primary-hover, primary-active, on-primary and primary-edge."
    },
    "primary-hover": {
      "$value": "{ref.color.neutral.200}"
    },
    "primary-active": {
      "$value": "{ref.color.neutral.300}"
    },
    "on-primary": {
      "$value": "{ref.color.neutral.950}"
    },
    "primary-edge": {
      "$value": "{ref.color.black-alpha.10}",
      "$description": "A 1px inner edge on the primary button, instead of a shadow."
    },
    "accent": {
      "$value": "{ref.color.brand.600}"
    },
    "accent-text": {
      "$value": "{ref.color.brand.300}"
    },
    "on-accent": {
      "$value": "{ref.color.neutral.0}"
    },
    "focus-ring": {
      "$value": "{ref.color.brand.300}"
    },
    "overlay": {
      "$value": "{ref.color.black-alpha.70}"
    },
    "info": {
      "$value": "{ref.color.brand.400}",
      "$description": "A quiet blue for neutral information, such as an info callout. It stays blue when a project changes its accent."
    },
    "info-surface": {
      "$value": "{ref.color.brand.950}"
    },
    "info-text": {
      "$value": "{ref.color.brand.200}"
    },
    "success": {
      "$value": "{ref.color.green.400}"
    },
    "success-surface": {
      "$value": "{ref.color.green.950}"
    },
    "success-text": {
      "$value": "{ref.color.green.200}"
    },
    "warning": {
      "$value": "{ref.color.amber.400}"
    },
    "warning-surface": {
      "$value": "{ref.color.amber.950}"
    },
    "warning-text": {
      "$value": "{ref.color.amber.200}"
    },
    "danger": {
      "$value": "{ref.color.red.400}"
    },
    "danger-surface": {
      "$value": "{ref.color.red.950}"
    },
    "danger-text": {
      "$value": "{ref.color.red.200}"
    },
    "accent-hover": {
      "$value": "{ref.color.brand.700}",
      "$description": "Override together with accent: a project that changes accent must change this too, or its buttons turn Plinth's blue on hover and press."
    },
    "accent-active": {
      "$value": "{ref.color.brand.800}",
      "$description": "Override together with accent: a project that changes accent must change this too, or its buttons turn Plinth's blue on hover and press."
    },
    "danger-solid": {
      "$value": "{ref.color.red.600}"
    },
    "danger-solid-hover": {
      "$value": "{ref.color.red.700}"
    },
    "danger-solid-active": {
      "$value": "{ref.color.red.800}"
    },
    "on-danger": {
      "$value": "{ref.color.neutral.0}"
    },
    "accent-subtle": {
      "$value": "{ref.color.brand.950}",
      "$description": "A tinted surface for selected states, such as the active nav item, with accent-text on it."
    },
    "accent-subtle-hover": {
      "$value": "{ref.color.brand.900}",
      "$description": "The selection tint under the pointer, on a pressed button that can be pressed again. Override together with accent-subtle."
    },
    "accent-subtle-active": {
      "$value": "{ref.color.brand.800}",
      "$description": "The selection tint while a pressed button is being pressed. Override together with accent-subtle."
    }
  },
  "elevation": {
    "$type": "shadow",
    "1": {
      "$value": {
        "color": "{ref.color.black-alpha.30}",
        "offsetX": "0",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0"
      }
    },
    "2": {
      "$value": {
        "color": "{ref.color.black-alpha.50}",
        "offsetX": "0",
        "offsetY": "4px",
        "blur": "12px",
        "spread": "0"
      }
    },
    "3": {
      "$value": {
        "color": "{ref.color.black-alpha.60}",
        "offsetX": "0",
        "offsetY": "12px",
        "blur": "32px",
        "spread": "0"
      }
    }
  }
}
