{
  "$description": "Semantic tokens for the light theme. A project overrides these.",
  "color": {
    "$type": "color",
    "surface": {
      "$value": "{ref.color.neutral.50}"
    },
    "surface-raised": {
      "$value": "{ref.color.neutral.0}"
    },
    "surface-sunken": {
      "$value": "{ref.color.neutral.100}"
    },
    "surface-hover": {
      "$value": "{ref.color.neutral.150}",
      "$description": "A small surface step for hover, never a colour jump."
    },
    "text": {
      "$value": "{ref.color.neutral.950}"
    },
    "text-muted": {
      "$value": "{ref.color.neutral.600}"
    },
    "text-subtle": {
      "$value": "{ref.color.neutral.500}",
      "$description": "The third text level: placeholders, timestamps, disabled labels."
    },
    "border": {
      "$value": "{ref.color.ink-alpha.10}",
      "$description": "Translucent, so it sits right on any surface."
    },
    "border-strong": {
      "$value": "{ref.color.ink-alpha.20}"
    },
    "divider": {
      "$value": "{ref.color.ink-alpha.6}"
    },
    "primary": {
      "$value": "{ref.color.neutral.950}",
      "$description": "The primary button: inverted neutral by default (ADR 3). A brand usually sets its own colour here, with primary-hover, primary-active, on-primary and primary-edge."
    },
    "primary-hover": {
      "$value": "{ref.color.neutral.800}"
    },
    "primary-active": {
      "$value": "{ref.color.neutral.700}"
    },
    "on-primary": {
      "$value": "{ref.color.neutral.0}"
    },
    "primary-edge": {
      "$value": "{ref.color.white-alpha.12}",
      "$description": "A 1px inner edge on the primary button, instead of a shadow."
    },
    "accent": {
      "$value": "{ref.color.brand.600}"
    },
    "accent-text": {
      "$value": "{ref.color.brand.700}"
    },
    "on-accent": {
      "$value": "{ref.color.neutral.0}"
    },
    "focus-ring": {
      "$value": "{ref.color.brand.600}"
    },
    "overlay": {
      "$value": "{ref.color.black-alpha.50}"
    },
    "info": {
      "$value": "{ref.color.brand.600}",
      "$description": "A quiet blue for neutral information, such as an info callout. It stays blue when a project changes its accent."
    },
    "info-surface": {
      "$value": "{ref.color.brand.100}"
    },
    "info-text": {
      "$value": "{ref.color.brand.800}"
    },
    "success": {
      "$value": "{ref.color.green.600}"
    },
    "success-surface": {
      "$value": "{ref.color.green.100}"
    },
    "success-text": {
      "$value": "{ref.color.green.800}"
    },
    "warning": {
      "$value": "{ref.color.amber.500}"
    },
    "warning-surface": {
      "$value": "{ref.color.amber.100}"
    },
    "warning-text": {
      "$value": "{ref.color.amber.800}"
    },
    "danger": {
      "$value": "{ref.color.red.600}"
    },
    "danger-surface": {
      "$value": "{ref.color.red.100}"
    },
    "danger-text": {
      "$value": "{ref.color.red.800}"
    },
    "accent-hover": {
      "$value": "{ref.color.brand.700}",
      "$description": "Override together with accent: a project that changes accent must change this too, or its buttons turn Plinth's blue on hover and press."
    },
    "accent-active": {
      "$value": "{ref.color.brand.800}",
      "$description": "Override together with accent: a project that changes accent must change this too, or its buttons turn Plinth's blue on hover and press."
    },
    "danger-solid": {
      "$value": "{ref.color.red.600}"
    },
    "danger-solid-hover": {
      "$value": "{ref.color.red.700}"
    },
    "danger-solid-active": {
      "$value": "{ref.color.red.800}"
    },
    "on-danger": {
      "$value": "{ref.color.neutral.0}"
    },
    "accent-subtle": {
      "$value": "{ref.color.brand.50}",
      "$description": "A tinted surface for selected states, such as the active nav item, with accent-text on it."
    }
  },
  "elevation": {
    "$type": "shadow",
    "1": {
      "$value": {
        "color": "{ref.color.black-alpha.10}",
        "offsetX": "0",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0"
      }
    },
    "2": {
      "$value": {
        "color": "{ref.color.black-alpha.15}",
        "offsetX": "0",
        "offsetY": "4px",
        "blur": "12px",
        "spread": "0"
      }
    },
    "3": {
      "$value": {
        "color": "{ref.color.black-alpha.15}",
        "offsetX": "0",
        "offsetY": "12px",
        "blur": "32px",
        "spread": "0"
      }
    }
  }
}
