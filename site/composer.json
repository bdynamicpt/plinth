{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "bdynamicpt/plinth-site",
    "type": "project",
    "description": "Plinth's website, built with Plinth.",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "bdynamicpt/plinth": "*@dev",
        "laravel/framework": "^13.17",
        "league/commonmark": "^2.10",
        "phiki/phiki": "^2.2"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.27",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../packages/blade",
            "options": {
                "symlink": false,
                "versions": {
                    "bdynamicpt/plinth": "dev-main"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": [
            "pint --test",
            "phpstan analyse --no-progress --memory-limit=1G"
        ],
        "format": "pint",
        "test": "pest --coverage --min=100",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
